{
  "name": "unia-daxie-bot",
  "version": "1.0.5",
  "description": "仅保留答谢功能的 B 站直播桌面程序",
  "main": "src/main.cjs",
  "author": "Unia",
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.cjs",
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win nsis",
    "build:portable": "node scripts/build-portable.cjs"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bilibili-live-ws": "^6.3.1",
    "electron-updater": "6.8.9",
    "fontkit": "^2.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.unia.daxiebot",
    "publish": [{ "provider": "github", "owner": "Polaris-Leo", "repo": "Unia-DaxieBot" }],
    "productName": "Unia答谢助手",
    "asar": true,
    "compression": "normal",
    "files": [
      "src/**/*",
      "package.json",
      "Unia-Icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "Unia-Icon.png"
    },
    "nsis": {
      "artifactName": "Unia-DaxieBot-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Unia-DaxieBot-${version}-Portable.${ext}"
    }
  }
}
